# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
coverage.xml
# Day 21: the JSON report the coverage gate writes, and the evidence file the
# QA dashboard can save. Build output, not source.
coverage.json
qa_evidence.json
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Documentation site build output (Day 25) — regenerated by `mkdocs build`,
# published by `.github/workflows/docs.yml`, never committed.
site/
.cache/

# Mutation-testing artefacts (Day 19) — local cache, regenerated on demand
mutants/
.mutmut-cache

# Environment & secrets — never commit these
.env
.env.*
*.pem
secrets.json

# Editor / OS noise
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Runtime output produced by the projects
projects/02_portfolio_tracker/portfolio_summary.csv
projects/03_file_organizer_automation/*.log
projects/04_terminal_assistant/*.jsonl
